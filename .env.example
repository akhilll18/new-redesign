# Server-side only (used by `npm run ai-proxy` / `npm start`). Never commit a real key.
ANTHROPIC_API_KEY=
PORT=8787
# AI_ALLOWED_ORIGINS=https://hr.example.com
# AI_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# AI_MAX_TOKENS=2000
# AI_RATE_PER_MIN=40

# Browser build: where the app should find the proxy (default ./api/ai, same origin)
# VITE_AI_PROXY_URL=https://ai.example.com/api/ai
