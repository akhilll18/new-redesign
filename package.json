{
  "name": "ezyo-hrms",
  "private": true,
  "version": "10.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/dropdown-inventory.mjs",
    "build": "vite build && node scripts/seo-prerender.mjs",
    "preview": "vite preview",
    "ai-proxy": "node server/ai-proxy.mjs",
    "start": "vite build && node server/ai-proxy.mjs",
    "mobile:sync": "vite build && node scripts/seo-prerender.mjs && cap sync",
    "android": "vite build && cap sync android && cap open android",
    "ios": "vite build && cap sync ios && cap open ios",
    "mobile:icons": "capacitor-assets generate --iconBackgroundColor '#ffffff' --splashBackgroundColor '#15414F'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  },
  "description": "EZY HR — AI-enabled HRMS by Ezyo (web, iOS, Android)."
}
