# EZY HR server — copy to .env (next to docker-compose.yml) and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-at-least-32-random-characters
# Public address of the site (canonical URLs, sitemap). Leave empty to use the address each request came in on.
SITE_URL=https://hr.yourcompany.com
# Extra origins allowed to call the API (another web host); the mobile apps are always allowed.
CORS_ORIGINS=
# Generative AI (optional)
ANTHROPIC_API_KEY=
# 1 = the pricing page can create a new company with its Super Admin
ALLOW_SIGNUP=0
# Scale-out
API_REPLICAS=2
WORKER_REPLICAS=1
PG_SHARED_BUFFERS=2GB
PG_CACHE=6GB
# Optional tuning (defaults shown)
# PG_POOL_MAX=20
# TOKEN_HOURS=12
# LOGIN_RATE_PER_MIN=20
# WS_EMPLOYEES_ADMIN=1500
# DEMO_OTP=0        # 1 shows one-time codes in API responses — tests only, never in production
